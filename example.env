# Public origin this service is reached at (used to build absolute URLs in TRMNL markup, e.g. airline logo banners)
PUBLIC_BASE_URL=https://trmnl.subtype.space

# WMATA
WMATA_PRIMARY_KEY=

# TRMNL
TRMNL_CLIENT_ID=
TRMNL_CLIENT_SECRET=
TRMNL_FLIGHTS_CLIENT_ID=
TRMNL_FLIGHTS_CLIENT_SECRET=

# AeroDataBox (flights plugin)
AERODATABOX_API_KEY=
# Provider: apimarket (default), rapidapi, or direct
AERODATABOX_PROVIDER=apimarket
# Cache TTLs in minutes (optional; defaults shown)
# AERODATABOX_ACTIVE_TTL_MIN=30
# AERODATABOX_SETTLED_TTL_MIN=240
# AERODATABOX_NOT_FOUND_TTL_MIN=55
# AERODATABOX_NEAR_DEPARTURE_TTL_MIN=15
# AERODATABOX_NEAR_DEPARTURE_WINDOW_MIN=120

# Optional
PORT=9595
LOG_LEVEL=info
TRMNL_DB_PATH=./trmnl.sqlite
TZ=America/New_York
