# Public origin this service is reached at (used to build absolute URLs in TRMNL markup, e.g. airline logo banners)
PUBLIC_BASE_URL=https://trmnl.subtype.space

# WMATA
WMATA_PRIMARY_KEY=

# TRMNL
TRMNL_CLIENT_ID=
TRMNL_CLIENT_SECRET=
TRMNL_FLIGHTS_CLIENT_ID=
TRMNL_FLIGHTS_CLIENT_SECRET=

# AeroDataBox (flights plugin)
AERODATABOX_API_KEY=
# Provider: apimarket (default) or rapidapi
AERODATABOX_PROVIDER=apimarket

# Optional
PORT=9595
LOG_LEVEL=info
TRMNL_DB_PATH=./trmnl.sqlite
TZ=America/New_York
