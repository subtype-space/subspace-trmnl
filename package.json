{
  "name": "subspace-trmnl",
  "version": "1.20.0",
  "description": "TRMNL plugin service for subtype.space",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:subtype-space/subspace-trmnl.git"
  },
  "keywords": [
    "subtype",
    "TRMNL"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf build && tsc && cp -r src/public build/public && cp package.json build/ && chmod 755 build/server.js",
    "start": "node build/server.js",
    "prod": "./run.sh prod",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npx tsx scripts/renderFlightPreview.ts",
    "trmnl:query": "npx tsx scripts/trmnlQuery.ts"
  },
  "files": [
    "build"
  ],
  "author": "subtype",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "dotenv": "^16.5.0",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "prettier": {
    "semi": false,
    "trailingComma": "es5",
    "singleQuote": true,
    "useTabs": false,
    "tabWidth": 2,
    "endOfLine": "lf",
    "printWidth": 128
  }
}
